# Obligatorias
ANTHROPIC_API_KEY=sk-ant-...
CHATWOOT_URL=https://chatwoot.tudominio.com
CHATWOOT_BOT_TOKEN=token-del-agent-bot
WEBHOOK_SECRET=un-secreto-largo-y-aleatorio

# Recomendada: token de un usuario administrador de Chatwoot para leer el historial
# (los tokens de Agent Bot no pueden listar mensajes).
CHATWOOT_API_TOKEN=

# Transcripción de notas de voz (API compatible con OpenAI). Proveedores: none, groq, openai, custom
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=            # por defecto: groq=whisper-large-v3-turbo, openai=gpt-4o-mini-transcribe
# TRANSCRIPTION_BASE_URL=         # obligatorio con TRANSCRIPTION_PROVIDER=custom
# TRANSCRIPTION_LANGUAGE=es

# Endpoint GET /usage (consumo por cliente). Vacío = deshabilitado.
ADMIN_TOKEN=

# Opcionales (valores por defecto)
# CLIENTS_DIR=/clients
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=16000
# CLAUDE_FALLBACKS=true
# HISTORY_LIMIT=20
# DEBOUNCE_SECONDS=2
# MAX_AGENT_STEPS=6
# LOG_LEVEL=INFO
# MEDIA_MAX_PER_RUN=4                    # imágenes/PDFs enviados a Claude por respuesta
# MEDIA_ALLOWED_HOSTS=                   # hosts extra desde donde descargar adjuntos (ej. el FRONTEND_URL de Chatwoot)
# USAGE_FILE=/data/usage.jsonl           # vacío = no registrar consumo
# RATE_LIMIT_CONVERSATION_PER_HOUR=20    # 0 = sin límite
# RATE_LIMIT_ACCOUNT_PER_DAY=1000        # 0 = sin límite
