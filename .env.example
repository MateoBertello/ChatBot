# Obligatorias
ANTHROPIC_API_KEY=sk-ant-...
CHATWOOT_URL=https://chatwoot.tudominio.com
CHATWOOT_BOT_TOKEN=token-del-agent-bot
WEBHOOK_SECRET=un-secreto-largo-y-aleatorio

# Recomendada: token de un usuario administrador de Chatwoot para leer el historial
# (los tokens de Agent Bot no pueden listar mensajes).
CHATWOOT_API_TOKEN=

